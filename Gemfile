group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
end

# Removed from Ruby's default gems in 3.x/4.x but still required by Jekyll.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
